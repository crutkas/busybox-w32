# Licensed under GPLv2, see file LICENSE in this source tree.

. ./testing.sh

# testing "test name" "command" "expected result" "file input" "stdin"
#   file input will be file called "input"
#   test can create a file "actual" instead of writing to stdout

# Need to call 'busybox test', otherwise shell builtin is used

testing "test: should be false (1)" \
	"busybox test; echo \$?" \
	"1\n" \
	"" ""

testing "test '': should be false (1)" \
	"busybox test ''; echo \$?" \
	"1\n" \
	"" ""

testing "test !: should be true (0)" \
	"busybox test !; echo \$?" \
	"0\n" \
	"" ""

testing "test a: should be true (0)" \
	"busybox test a; echo \$?" \
	"0\n" \
	"" ""

testing "test --help: should be true (0)" \
	"busybox test --help; echo \$?" \
	"0\n" \
	"" ""

testing "test -f: should be true (0)" \
	"busybox test -f; echo \$?" \
	"0\n" \
	"" ""

testing "test ! -f: should be false (1)" \
	"busybox test ! -f; echo \$?" \
	"1\n" \
	"" ""

testing "test a = a: should be true (0)" \
	"busybox test a = a; echo \$?" \
	"0\n" \
	"" ""

testing "test -lt = -gt: should be false (1)" \
	"busybox test -lt = -gt; echo \$?" \
	"1\n" \
	"" ""

testing "test a -a !: should be true (0)" \
	"busybox test a -a !; echo \$?" \
	"0\n" \
	"" ""

testing "test -f = a -o b: should be true (0)" \
	"busybox test -f = a -o b; echo \$?" \
	"0\n" \
	"" ""

testing "test ! a = b -a ! c = c: should be false (1)" \
	"busybox test ! a = b -a ! c = c; echo \$?" \
	"1\n" \
	"" ""

testing "test ! a = b -a ! c = d: should be true (0)" \
	"busybox test ! a = b -a ! c = d; echo \$?" \
	"0\n" \
	"" ""

testing "test '!' = '!': should be true (0)" \
	"busybox test '!' = '!'; echo \$?" \
	"0\n" \
	"" ""

testing "test '(' = '(': should be true (0)" \
	"busybox test '(' = '('; echo \$?" \
	"0\n" \
	"" ""

testing "test '!' '!' = '!': should be false (1)" \
	"busybox test '!' '!' = '!'; echo \$?" \
	"1\n" \
	"" ""

testing "test '!' '(' = '(': should be false (1)" \
	"busybox test '!' '(' = '('; echo \$?" \
	"1\n" \
	"" ""

optional PLATFORM_MINGW32
testing "test -r uses Windows read access for files owned by another account" \
	"p=\"\$(cygpath -u \"\$SYSTEMROOT/System32/kernel32.dll\")\"; test -e \"\$p\"; echo exists=\$?; test -r \"\$p\"; echo builtin=\$?; busybox test -r \"\$p\"; echo applet=\$?; head -c 1 \"\$p\" >/dev/null; echo read=\$?; test -r .; echo directory=\$?" \
	"exists=0\nbuiltin=0\napplet=0\nread=0\ndirectory=0\n" \
	"" ""

testing "test -r rejects ACL-denied and missing files" \
	"p=unreadable; printf denied >\"\$p\"; icacls \"\$p\" /inheritance:r /deny '*S-1-1-0:(R)' >/dev/null; test -e \"\$p\"; echo exists=\$?; test -r \"\$p\"; echo builtin=\$?; busybox test -r \"\$p\"; echo applet=\$?; head -c 1 \"\$p\" >/dev/null 2>&1; echo read=\$?; icacls \"\$p\" /reset >/dev/null; rm -f \"\$p\"; test -r missing; echo missing=\$?" \
	"exists=0\nbuiltin=1\napplet=1\nread=1\nmissing=1\n" \
	"" ""

exit $FAILCOUNT
